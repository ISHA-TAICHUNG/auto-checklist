{
  "name": "isha-line-webhook-relay",
  "main": "index.mjs",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "preview_urls": false,
  // 只保留 console 的固定錯誤碼；關閉請求紀錄與追蹤，並遮蔽網址參數，避免 token 進入紀錄。
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "send_metrics": false
}
